project_id = "gen-lang-client-0031150958"
region     = "europe-west1"
image      = "europe-west1-docker.pkg.dev/gen-lang-client-0031150958/cloud-run-source-deploy/mon-service:latest"

# Free-tier VM (us-central1-a, e2-micro) with a public IP and PostgreSQL + PostGIS + TimescaleDB (defaults).
# The public IP costs about 3.65 USD/month; set both to false to stay at 0 USD.
# vm_external_ip      = true
# install_timescaledb = true

# Identity Platform (user management). Email/password is enabled by default.
# identity_authorized_domains   = ["localhost", "app.example.com"]
# Optional "Sign in with Google" (OAuth client created in the console):
# identity_google_client_id     = "xxxx.apps.googleusercontent.com"
# identity_google_client_secret = "..."   # better: pass it with --input-values, never commit it
